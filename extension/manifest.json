{
  "manifest_version": 3,
  "name": "OBS登録者カウンター",
  "version": "2.1.10",
  "version_name": "Pre-release v2.1.10",
  "description": "YouTube Studioで選択した登録者数をOBSのテキストソースへ反映します。",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "activeTab", "tabs", "alarms"],
  "host_permissions": ["https://studio.youtube.com/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OBS登録者カウンター",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://studio.youtube.com/*"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:* ws://localhost:*"
  }
}
